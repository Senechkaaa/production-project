{
    "compilerOptions": {
        "outDir": "./dist/",
        //   то, куда производится сборка
        "noImplicitAny": true,
        //    не позволяет использовать переменные без явного типа
        "module": "ESNext",
        "target": "es5",
        "jsx": "react-jsx",
        "allowJs": true,
        //   обрабатывает не только ts файлы, но и js,
        "strict": true,
        "moduleResolution": "node",
        "allowSyntheticDefaultImports": true,
        //   позволяет работать с пакетами, которые используют
        "esModuleInterop": true,
        //   для поддержки export default
        "baseUrl": ".",
        "paths": {
            "*": ["./src/*"]
        }
    },
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    },
    "include": [
        "./jest-setup.ts",
        // чтобы работал jest dom
        "./src/**/*.ts",
        "./src/**/*.tsx"
    ]
}
